  "description": "LLM-controlled network protocol servers & clients (~290 servers, ~250 clients) with an MCP server mode. Launcher that runs the platform-native netget binary.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netget-net/netget.git"
  },
  "homepage": "https://github.com/netget-net/netget",
  "bugs": "https://github.com/netget-net/netget/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "llm",
    "network",
    "protocol",
    "server",
    "honeypot",
    "ollama"
  ],
  "bin": {
    "netget": "bin/netget.js"
  },
  "files": [
