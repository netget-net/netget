    "@smotana/netget-linux-x64": "0.0.0-dev",
    "@smotana/netget-linux-arm64": "0.0.0-dev",
    "@smotana/netget-linux-x64-musl": "0.0.0-dev",
    "@smotana/netget-win32-x64": "0.0.0-dev"
  }
}
