/target
netget.log

# Instance-specific build directories for concurrent Claude instances
/target-claude/
/target-test-*/
/$(pwd)/

# Local temporary directory (used instead of /tmp for project isolation)
/tmp/
/test-results/

# Local MCP server config — contains a machine-specific path and an API key.
# Use .mcp.json.example as a template; never commit the real one.
/.mcp.json

logs
*.log
# Rotated logs (netget.log.1, netget.log.2, …), which *.log does not match
*.log.*

# Python bytecode from scripts/ and fuzz/ helpers
__pycache__/
*.py[cod]

# Paseo workspace config, written per machine
/paseo.json

# Worktrees and ad-hoc checkouts of this repository made inside it
/.claude/worktrees/
/.worktrees/
/worktrees/
/.audit-integration-*/
/.p2p-news-work/
/.*-work/

# Ollama lock files for concurrent instance coordination
ollama.lock
netget-ollama.lock

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
target-etcd-build/
.aider*

# Stray compiler outputs from ad-hoc rustc invocations
*.rlib

# SQLite databases created by the runtime sqlite facility
netget_db_*.db

# Run artefacts NetGet writes into its working directory when started from the checkout (as
# `cargo test` does): `append_to_log` output (netget_<name>_<time>_s<id>.log, covered by *.log
# above), Unix socket nodes (`ssh_agent`'s ./netget-ssh-agent.sock, `socket_file`'s
# ./netget.sock) and `pty`'s slave symlink; plus the empty pki/{trusted,rejected} trust store
# that OPC UA tooling run from the checkout leaves behind.
*.sock
/netget.pty
/pki/

# Generated npm packages
/dist/

# Snapshot test output written only on mismatch; never committed.
*.actual.snap.md

# Built by ./web/build.sh; uploaded by ./site/deploy.sh, never committed
/site/demo/pkg/
